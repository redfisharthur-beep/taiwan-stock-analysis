{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taiwan-stock-analysis",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 11 * * MON-FRI",
      "30 11 * * FRI"
    ]
  },
  "d1_databases": [
    {
      "binding": "MARKET_DB",
      "database_name": "taiwan-stock-market",
      "database_id": "604d9a35-ed8f-4edb-a396-0213b361349e",
      "migrations_dir": "migrations"
    }
  ]
}
